BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
MONGODB_URI=
MONGODB_DB=booknook

# Express + MongoDB API used for books and borrows.
NEXT_PUBLIC_SERVER_BASE_URL=http://localhost:8000

# ImgBB API key used by /api/upload for book cover images. Optional: if it is
# missing or rejected, covers are stored in MongoDB and served from
# /api/images/<id>. The route also accepts NEXT_PUBLIC_IMGBB_API_KEY.
IMGBB_API_KEY=

# Google OAuth (optional; the Google button reports an error until both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
